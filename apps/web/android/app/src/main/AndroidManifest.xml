<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Pozivnice (App Links): https://<host>/room/<id> otvara aplikaciju
                 umjesto browsera. autoVerify traži da host servira
                 /.well-known/assetlinks.json sa otiskom ključa kojim je OVAJ paket
                 potpisan (apps/web/public/.well-known/) — bez toga Android link
                 i dalje šalje u browser. Host ide po build tipu (build.gradle),
                 da staging i produkcijski APK ne polažu pravo na isti domen.
                 Samo putanje soba: /privatnost, /uslovi i ostalo ostaju web.
                 Link u JS-u prima NativeShell. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${deepLinkHost}" />
                <data android:pathPrefix="/room/" />
                <data android:pathPrefix="/zandar/room/" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Push (PRD §51): ikonica u traci kad poruka ne navede svoju. Bijela
             silueta, jer Android crta masku (res/drawable/ic_stat_notify.xml).
             POST_NOTIFICATIONS dozvolu donosi @capacitor/push-notifications
             kroz spajanje manifesta. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />

        <!-- Meta App Events: instalacija i otvaranje, samo uz saglasnost igrača.
             Provider bi digao SDK pri svakom pokretanju, prije saglasnosti, pa ga
             pokreće isključivo MetaEventsPlugin. Naslovi ekrana, AppLink adrese i
             raspored ekrana se ne šalju. -->
        <provider
            android:name="com.facebook.internal.FacebookInitProvider"
            android:authorities="${applicationId}.FacebookInitProvider"
            tools:node="remove" />
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogMetaDataEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogProductImprovementEnabled"
            android:value="false" />

        <!-- Google Analytics: placeholder po build tipu (build.gradle), uključen
             samo u `release`. Služi samo za statistiku, pa su reklamni signali
             isključeni i ne uzima reklamni ID; AD_ID u paketu postoji samo zbog
             Mete, uz saglasnost igrača. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="${googleAnalyticsEnabled}" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
    </application>

    <!-- Permissions -->

    <!-- facebook-core ih donosi za Privacy Sandbox; mjerenju instalacija ne trebaju,
         a daljinski prekidač bi kroz njih mogao uključiti custom audience.
         AD_ID ostaje: bez njega nema atribucije. -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- lib/haptics.ts → navigator.vibrate; bez dozvole je tihi no-op. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
